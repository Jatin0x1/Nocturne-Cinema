<%@ page pageEncoding="UTF-8" %>
<%@ include file="/includes/header.jspf" %>
<section class="page-intro"><div class="eyebrow">THE NOCTURNE COLLECTION</div><h1>Your next <em>story</em> starts here.</h1><p>Find your favourite film and make tonight unforgettable.</p></section>
<section class="section catalog-section"><form class="filter-bar" action="<%=ctx%>/movies" method="get"><label class="search-field"><span>⌕</span><input type="search" name="q" value="${q}" placeholder="Find a film..."></label><select name="genre" aria-label="Filter by genre"><option value="">All genres</option><% java.util.List<String> genres=(java.util.List<String>)request.getAttribute("genres"); if(genres!=null) for(String g:genres){ %><option value="<%=g%>" <%=g.equals(request.getAttribute("genre"))?"selected":""%>><%=g%></option><%}%></select><select name="language" aria-label="Filter by language"><option value="">All languages</option><% java.util.List<String> langs=(java.util.List<String>)request.getAttribute("languages"); if(langs!=null) for(String l:langs){ %><option value="<%=l%>" <%=l.equals(request.getAttribute("language"))?"selected":""%>><%=l%></option><%}%></select><select name="sort" aria-label="Sort movies"><option value="">Featured order</option><option value="title" ${sort == 'title' ? 'selected' : ''}>Title A–Z</option><option value="price" ${sort == 'price' ? 'selected' : ''}>Price: low to high</option></select><button class="button button-small" type="submit">Apply filters</button></form>
<p class="result-count">${movies.size()} FILM<% if (request.getAttribute("movies") instanceof java.util.List && ((java.util.List)request.getAttribute("movies")).size()!=1) { %>S<% } %> IN THE COLLECTION</p><div class="movie-grid"><% java.util.List<com.moviebooking.model.Movie> movies=(java.util.List<com.moviebooking.model.Movie>)request.getAttribute("movies"); if(movies!=null && !movies.isEmpty()) for(com.moviebooking.model.Movie m:movies){ %><article class="movie-card"><a class="poster-wrap" href="<%=ctx%>/details?id=<%=m.getId()%>" aria-label="View details for <%=m.getTitle()%>"><img src="<%=ctx%><%=m.getPosterUrl()%>" alt="Official poster for <%=m.getTitle()%>" onerror="this.style.display='none';this.parentNode.classList.add('poster-fallback')"><span class="poster-shade"></span><span class="poster-index"><%=m.getAgeRating()%></span><span class="poster-play">▶</span></a><div class="movie-info"><div><h3><a href="<%=ctx%>/details?id=<%=m.getId()%>"><%=m.getTitle()%></a></h3><p><%=m.getGenre()%> <span>·</span> <%=m.getDurationMinutes()%> min <span>·</span> <%=m.getLanguage()%></p></div></div><div class="card-bottom"><span>₹<%=m.getTicketPrice()%> <small>/ seat</small></span><a class="text-link" href="<%=ctx%>/details?id=<%=m.getId()%>">View details ↗</a></div></article><% } else { %><div class="empty-state"><span>✳</span><h2>No films found</h2><p>Try a different search or clear one of your filters.</p><a class="button button-outline" href="<%=ctx%>/movies">Clear filters</a></div><% } %></div></section>
<%@ include file="/includes/footer.jspf" %>




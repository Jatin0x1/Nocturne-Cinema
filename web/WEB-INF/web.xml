<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd" version="4.0">
  <display-name>Nocturne Cinema</display-name>
  <listener><listener-class>com.moviebooking.servlet.AppLifecycleListener</listener-class></listener>
  <servlet><servlet-name>home</servlet-name><servlet-class>com.moviebooking.servlet.HomeServlet</servlet-class></servlet>
  <servlet><servlet-name>movies</servlet-name><servlet-class>com.moviebooking.servlet.MovieServlet</servlet-class></servlet>
  <servlet><servlet-name>booking</servlet-name><servlet-class>com.moviebooking.servlet.BookingServlet</servlet-class></servlet>
  <servlet><servlet-name>myBookings</servlet-name><servlet-class>com.moviebooking.servlet.MyBookingsServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>home</servlet-name><url-pattern>/home</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>movies</servlet-name><url-pattern>/movies</url-pattern><url-pattern>/movie</url-pattern><url-pattern>/details</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>booking</servlet-name><url-pattern>/book</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>myBookings</servlet-name><url-pattern>/bookings</url-pattern></servlet-mapping>
  <welcome-file-list><welcome-file>home</welcome-file></welcome-file-list>
  <session-config><session-timeout>30</session-timeout></session-config>
</web-app>

<%@ page pageEncoding="UTF-8" %>
<%@ include file="/includes/header.jspf" %>
<section class="detail-hero"><div class="detail-backdrop" style="background-image:url('<%=ctx%>${movie.posterUrl}')"></div><div class="detail-layout"><div class="detail-poster"><img src="<%=ctx%>${movie.posterUrl}" alt="Official poster for ${movie.title}" onerror="this.style.display='none';this.parentNode.classList.add('poster-fallback')"></div><div class="detail-copy"><a class="back-link" href="<%=ctx%>/movies">← ALL FILMS</a><div class="eyebrow">FEATURED COLLECTION · ${movie.genre}</div><h1>${movie.title}</h1><div class="detail-facts"><span>${movie.durationMinutes} MIN</span><span>${movie.language}</span><span>${movie.ageRating}</span></div><p>${movie.description}</p><div class="price-line">₹${movie.ticketPrice} <small>per seat</small></div></div></div></section>
<section class="booking-section" id="booking"><div class="booking-heading"><div><div class="eyebrow">YOUR NIGHT, YOUR WAY</div><h2>Pick your <em>seats.</em></h2></div><p>Select a date, a show, then the seats you love.</p></div>
<% if(request.getAttribute("errorMessage")!=null){ %><div class="alert"><%=request.getAttribute("errorMessage")%></div><% } %>
<form action="<%=ctx%>/book" method="post" id="bookingForm" data-details-url="<%=ctx%>/movie?id=${movie.id}"><input type="hidden" name="movieId" value="${movie.id}"><div class="booking-controls"><label>DATE<input type="date" name="date" id="showDate" value="${selectedDate}" required></label><label>SHOWTIME<select name="time" id="showTime" required><option value="">Choose showtime</option><% java.util.List<String> showtimes=(java.util.List<String>)request.getAttribute("showtimes"); if(showtimes!=null) for(String t:showtimes){%><option value="<%=t%>" <%=t.equals(request.getAttribute("selectedTime"))?"selected":""%>><%=t%></option><%}%></select></label></div>
<div class="seat-panel"><div class="screen-wrap"><div class="screen"></div><small>THE SCREEN</small></div><div class="seat-map"><% java.util.Set<String> seatSet=(java.util.Set<String>)request.getAttribute("seats"); java.util.List<String> booked=(java.util.List<String>)request.getAttribute("bookedSeats"); for(char row='A';row<='F';row++){%><div class="seat-row"><span class="row-label"><%=row%></span><%for(int n=1;n<=10;n++){String seat=row+String.valueOf(n); boolean unavailable=booked!=null&&booked.contains(seat);%><label class="seat <%=unavailable?"seat-booked":""%>"><input type="checkbox" name="seats" value="<%=seat%>" aria-label="Seat <%=seat%>" <%=unavailable?"disabled":""%>><span><%=n%></span></label><%}%><span class="row-label"><%=row%></span></div><%}%></div><div class="seat-legend"><span><i class="legend-seat"></i> Available</span><span><i class="legend-seat selected"></i> Selected</span><span><i class="legend-seat booked"></i> Booked</span></div></div>
<div class="booking-submit"><div><small>YOUR TOTAL</small><strong id="totalPrice">₹0</strong><span id="seatCount">Select seats to continue</span></div><button class="button button-primary" type="submit">Continue to confirmation <span>↗</span></button></div></form></section>
<%@ include file="/includes/footer.jspf" %>




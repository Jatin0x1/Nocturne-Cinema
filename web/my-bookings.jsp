<%@ page pageEncoding="UTF-8" %>
<%@ include file="/includes/header.jspf" %>
<section class="page-intro"><div class="eyebrow">YOUR NOCTURNE ACCOUNT</div><h1>My <em>bookings.</em></h1><p>Your plans for the big screen, all in one place.</p></section>
<section class="section bookings-section"><% com.moviebooking.model.Booking confirmed=(com.moviebooking.model.Booking)request.getAttribute("confirmedBooking"); if(confirmed!=null){%><div class="confirmation-card"><div class="confirm-icon">✓</div><div class="eyebrow">YOUR NIGHT IS BOOKED</div><h2>It's a <em>date.</em></h2><p>Your seats are waiting. Here's your ticket at a glance.</p><div class="ticket"><div><small>BOOKING REFERENCE</small><strong><%=confirmed.getReference()%></strong></div><div><small>FILM</small><strong><%=confirmed.getMovieTitle()%></strong></div><div><small>DATE & SHOW</small><strong><%=confirmed.getShowDate()%> · <%=confirmed.getShowTime()%></strong></div><div><small>SEATS</small><strong><%=confirmed.getSeats()%></strong></div><div><small>TICKETS</small><strong><%=confirmed.getTicketCount()%></strong></div><div><small>TOTAL PAID</small><strong>₹<%=confirmed.getTotalAmount()%></strong></div></div><div class="confirm-actions"><button class="button button-outline" onclick="window.print()">Print ticket</button><a class="button button-primary" href="<%=ctx%>/movies">Book another movie ↗</a></div></div><%}%>
<div class="section-heading"><div><div class="eyebrow">SESSION HISTORY</div><h2>Saved for <em>tonight.</em></h2></div></div><% java.util.List<com.moviebooking.model.Booking> list=(java.util.List<com.moviebooking.model.Booking>)request.getAttribute("bookings"); if(list==null||list.isEmpty()){%><div class="empty-state"><span>✳</span><h2>No bookings yet</h2><p>Your bookings from this browser session will appear here.</p><a class="button button-primary" href="<%=ctx%>/movies">Find your film ↗</a></div><%}else{%><div class="booking-list"><%for(com.moviebooking.model.Booking b:list){%><article class="booking-row"><div><small><%=b.getReference()%></small><h3><%=b.getMovieTitle()%></h3></div><div><small>SHOW</small><strong><%=b.getShowDate()%> · <%=b.getShowTime()%></strong></div><div><small>SEATS</small><strong><%=b.getSeats()%></strong></div><div><small>TOTAL</small><strong>₹<%=b.getTotalAmount()%></strong></div></article><%}%></div><%}%><p class="session-note">Bookings are kept in your current session for this demonstration. They are not permanent and can reset when the server restarts.</p></section>
<%@ include file="/includes/footer.jspf" %>
